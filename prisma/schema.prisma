generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  client
  admin
  developer
}

enum CommandeStatut {
  en_attente
  confirme
  expedie
  livre
  annule
}

enum ProduitStatut {
  brouillon
  publie
}

model Boutique {
  id          String   @id @default(cuid())
  nom         String
  slug        String   @unique
  description String?
  logoUrl     String?
  createdAt   DateTime @default(now())
  produits    Produit[]

  @@index([nom])
}

model Produit {
  id          String          @id @default(cuid())
  nom         String
  slug        String          @unique
  description String?
  prix        Decimal         @db.Decimal(10, 2)
  prixPromo   Decimal?        @db.Decimal(10, 2)
  stock       Int             @default(0)
  categorie   String?
  marque      String?
  sku         String?         @unique
  tailles     String[]        @default([])
  couleurs    String[]        @default([])
  statut      ProduitStatut   @default(brouillon)
  boutiqueId  String
  createdAt   DateTime        @default(now())
  boutique    Boutique        @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  images      ImageProduit[]
  lignes      LigneCommande[]

  @@index([boutiqueId])
  @@index([slug])
}

model ImageProduit {
  id        String  @id @default(cuid())
  produitId String
  url       String
  ordre     Int     @default(0)
  produit   Produit @relation(fields: [produitId], references: [id], onDelete: Cascade)

  @@index([produitId, ordre])
}

model Utilisateur {
  id             String    @id @default(cuid())
  email          String    @unique
  motDePasseHash String
  role           Role      @default(client)
  createdAt      DateTime  @default(now())
  commandes      Commande[]
}

model Commande {
  id          String          @id @default(cuid())
  utilisateurId String
  statut      CommandeStatut  @default(en_attente)
  total       Decimal         @db.Decimal(10, 2)
  createdAt   DateTime        @default(now())
  utilisateur Utilisateur     @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  lignes      LigneCommande[]

  @@index([utilisateurId])
  @@index([statut])
}

model LigneCommande {
  id          String   @id @default(cuid())
  commandeId  String
  produitId   String
  quantite    Int
  prixUnitaire Decimal @db.Decimal(10, 2)
  commande    Commande @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  produit     Produit  @relation(fields: [produitId], references: [id], onDelete: Restrict)

  @@index([commandeId])
  @@index([produitId])
}
