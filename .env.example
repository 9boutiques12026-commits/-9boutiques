# Base de données PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/9boutiques?schema=public"

# NextAuth
NEXTAUTH_SECRET="change-me-please"
NEXTAUTH_URL="http://localhost:3000"

# Compte admin créé par le seed / script create-admin (optionnel)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Téléversement d'images : "local" en dev, "cloudinary" en prod
UPLOAD_PROVIDER="local"
UPLOAD_CLOUDINARY_CLOUD_NAME=""
UPLOAD_CLOUDINARY_API_KEY=""
UPLOAD_CLOUDINARY_API_SECRET=""

# URL publique du site (liens dans les emails). En prod : https://votre-domaine
APP_URL="http://localhost:3000"

# Envoi d'emails (mot de passe oublié). Vide en local => le lien est journalisé.
# En prod, SMTP réel (ex. Gmail + "mot de passe d'application").
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""
